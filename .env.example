# Copy to .env and fill in. Never commit .env.

# ---- PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/fresherradar
DB_USERNAME=fresherradar
DB_PASSWORD=change-me

# ---- Server / CORS ----
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- Admin endpoints (X-Admin-Token header). Empty = disabled ----
ADMIN_TOKEN=

# ---- Scheduler (daily, 02:00 IST by default) ----
SCHEDULER_ENABLED=true
REFRESH_CRON=0 0 2 * * *
REFRESH_ZONE=Asia/Kolkata
MAX_JOB_AGE_DAYS=45

# ---- Source: Adzuna API (register at https://developer.adzuna.com) ----
ADZUNA_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_QUERIES=fresher,entry level,graduate trainee,intern,internship,junior developer,campus hiring
ADZUNA_PAGES=4

# ---- Source: RSS/Atom feeds you are permitted to read: Name|URL,Name|URL ----
RSS_ENABLED=false
RSS_FEEDS=

# ---- LLM ----
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5
# USD per 1,000,000 tokens - copy from your provider's current pricing page. Cost reports show 0 until set.
LLM_INPUT_PRICE_PER_M=0
LLM_OUTPUT_PRICE_PER_M=0
LLM_MIN_CONFIDENCE=0.5
LLM_BATCH_LIMIT=1000
